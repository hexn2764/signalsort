{
  "name": "signalsort",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "agent:reporter": "tsx src/agents/reporter.ts",
    "agent:triage": "tsx src/agents/triage.ts",
    "agent:solver": "tsx src/agents/solver.ts",
    "autopilot": "node scripts/autopilot.mjs",
    "autopilot:fast": "REPORT_MIN_MS=45000 REPORT_MAX_MS=90000 TRIAGE_INTERVAL_MS=20000 SOLVE_INTERVAL_MS=20000 node scripts/autopilot.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
